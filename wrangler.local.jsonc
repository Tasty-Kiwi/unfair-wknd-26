// Local development only. Never deploy this configuration or its placeholder DB ID.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "domino-os-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"],
  },
  "vars": { "CLOUD_ENABLED": "false" },
  // Dormant backend: select --env cloud explicitly to use OAuth and D1.
  "env": {
    "cloud": {
      "name": "domino-os-local",
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api", "/api/*"],
      },
      "vars": {
        "CLOUD_ENABLED": "true",
        "AUTH_URL": "http://localhost:5173",
      },
      "secrets": {
        "required": ["GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET"],
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "domino-os-local",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations",
          "remote": false,
        },
      ],
    },
  },
}
