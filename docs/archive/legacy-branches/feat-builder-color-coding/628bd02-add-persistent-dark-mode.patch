diff --git a/index.html b/index.html
index cb50f37..b4df1fe 100644
--- a/index.html
+++ b/index.html
@@ -9,6 +9,20 @@
       content="DominoOS — see what breaks before it breaks. An interactive, fictional manufacturing material-availability simulator."
     />
     <title>DominoOS — material availability what-if</title>
+    <script>
+      // Set the theme before first paint so dark mode never flashes light.
+      (function () {
+        // /landing applies the same preference itself.
+        if (location.pathname.replace(/\/$/, "") === "/landing") return;
+        try {
+          var t = localStorage.getItem("dominoos.landing.theme.v2");
+          if (t !== "light" && t !== "dark")
+            t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
+          if (t === "dark") document.documentElement.classList.add("dark");
+          document.documentElement.style.colorScheme = t;
+        } catch (e) {}
+      })();
+    </script>
   </head>
   <body>
     <div id="root"></div>
